{
    "manifest_version": 3,
    "name": "Feedback Tracker",
    "version": "2.0",
    "description": "Capture elementos e crie issues no Jira com screenshots",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "tabs",
        "desktopCapture"
    ],
    "host_permissions": [
        "https://api.imgbb.com/*",
        "https://*.atlassian.net/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "options_page": "options.html",
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "icons": {
        "48": "icon.png",
        "128": "icon.png"
    }
}