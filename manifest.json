{
    "manifest_version": 3,
    "name": "Feedback Tracker",
    "version": "1.0",
    "description": "Registre feedbacks clicando nos elementos do site.",
    "permissions": ["activeTab", "storage", "scripting", "tabs"],
    "host_permissions": ["https://api.airtable.com/v0/*"],
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
      }
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_idle"
      }
    ]
}